# Copy this file to .env.local and fill in your Supabase project values.
# .env.local is gitignored — never commit it.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Data source:
# - auto: local dev uses Supabase when configured, otherwise dev mock data;
#         production uses Supabase only and never silently falls back to mocks.
# - supabase: require Supabase in every environment.
# - mock: force the generated day-10 tournament mock. Do not use on Vercel production.
VITE_DATA_SOURCE=auto

# Optional escape hatch for preview builds only. Leave false/unset in production.
VITE_ALLOW_MOCK_DATA=false
